{
  "name": "hono-open-api-starter",
  "type": "module",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --max-old-space-size=8192 src/index.ts",
    "start": "node --max-old-space-size=8192 ./dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "npm run lint --fix",
    "build": "tsc && tsc-alias && node -e \"const fs=require('fs'); fs.cpSync('src/lib/zhipu', 'dist/src/lib/zhipu', {recursive:true})\""
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@hono/node-server": "^1.13.2",
    "@hono/zod-openapi": "^0.16.4",
    "@langchain/community": "^0.3.17",
    "@langchain/core": "^0.3.23",
    "@libsql/client": "^0.14.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@scalar/hono-api-reference": "^0.5.156",
    "@zilliz/milvus2-sdk-node": "^2.5.1",
    "amqp-ts": "^1.8.0",
    "amqplib": "^0.10.5",
    "argon2": "^0.41.1",
    "cheerio": "^1.0.0",
    "cos-nodejs-sdk-v5": "^2.14.6",
    "d3-dsv": "2",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^11.0.6",
    "drizzle-orm": "^0.33.0",
    "drizzle-zod": "^0.5.1",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "hono": "^4.7.1",
    "hono-pino": "^0.4.0",
    "langchain": "^0.3.6",
    "mammoth": "^1.8.0",
    "openapi3-ts": "^4.4.0",
    "p-limit": "^7.2.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "stoker": "^1.2.7",
    "zhipuai-sdk-nodejs-v4": "^0.1.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.8.0",
    "@types/amqplib": "^0.10.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.7.9",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.24.2",
    "eslint": "^9.13.0",
    "eslint-plugin-format": "^0.1.2",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
